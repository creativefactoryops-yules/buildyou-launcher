{
  "version": 1,
  "defaultBranch": "main",
  "stack": "android-kotlin-compose",
  "commands": {
    "install": "./gradlew --no-daemon -q help",
    "dev": null,
    "build": "./gradlew --no-daemon assembleDebug",
    "test": "./gradlew --no-daemon testDebugUnitTest",
    "testOne": null,
    "typecheck": "./gradlew --no-daemon compileDebugKotlin",
    "lint": "./gradlew --no-daemon lintDebug"
  },
  "verify": ["typecheck", "lint", "build"],
  "docsHash": "56954e584f6a3a071b098c04f52f589535d6c2fff6250035db7fcb48b6b6722a",
  "verified": false,
  "loop": {
    "maxAutoVerifyIterations": 3,
    "resumeStepBudget": 8,
    "perCommandTimeoutMs": 600000,
    "sameFailureStop": 2,
    "oscillationWindow": 4,
    "gatePullRequest": true
  },
  "ignore": ".digbyignore"
}
