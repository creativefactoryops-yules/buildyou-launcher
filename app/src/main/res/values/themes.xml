<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Dark-only theme. parent=android:Theme.Material.NoActionBar keeps the platform
      chrome dark without pulling appcompat (not needed for a single Compose activity).
    -->
    <style name="Theme.BuildYou" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/deck_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
